# Python
venv/
__pycache__/
*.pyc
*.pyo

# Environment/secrets (from Stage 6 onward)
.env

# Databases (from Stage 3 onward)
*.db
*.sqlite3

# Hestia's file-tool sandbox — the user's own files (from Stage 5 onward)
workspace/

# The launch allowlist (from Stage 6 onward): real install paths, and
# often a username inside them. apps.yaml.example shows the format.
apps.yaml

# The repo allowlist (from Stage 7 onward): real folder paths, for the
# same reason. repos.yaml.example shows the format.
repos.yaml

# The shortcut icon, drawn from gui.py's hestia_icon() when a shortcut is made.
data/hestia.ico
data/docker-started-by-hestia

# Downloaded voice models (from Stage 10): scripts/download_models.py fetches them.
models/

# OS/editor cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Voice samples from scripts/voice_audition.py --save
audition/
